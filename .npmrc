# 公開から日の浅いパッケージバージョンをインストール対象から除外する。
# 新バージョン公開直後のサプライチェーン攻撃（悪意ある publish）を緩和するため。

# npm 用。値は日数（整数）。npm が内部で before 日付に変換する。
# ref: https://docs.npmjs.com/cli/v11/commands/npm-install#min-release-age
min-release-age=3

# pnpm 用。値は分。pnpm は min-release-age を解釈しないため、同じ 3 日を
# 分に換算して別キーで指定する。lockfile の更新は pnpm で行うので、
# 実効的な cooldown はこちらが担う。
# ref: https://pnpm.io/settings#minimumreleaseage
minimum-release-age=4320
