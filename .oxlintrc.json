{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    /** ── Security: restriction ルールから個別に有効化 ── */
    "no-eval": "error",
    "no-new-func": "error",
    "no-alert": "error",
    "no-script-url": "error",

    /** ── Complexity: 条件分岐の複雑度を制限 ── */
    "complexity": ["error", { "max": 15 }],

    /** ── Promoted: pedantic/style → error に昇格 ── */
    "prefer-const": "error",
    "no-var": "error",

    /** ── CLI ツールのため console 許可 ── */
    "no-console": "off",

    /** ── TypeScript 厳格化 ── */
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unsafe-type-assertion": "warn",
    "typescript/ban-ts-comment": "warn",
    "typescript/no-import-type-side-effects": "warn",
    "typescript/prefer-optional-chain": "warn",
    "typescript/no-unnecessary-type-assertion": "off",

    /** ── Unicorn: プロジェクト慣習に合わない pedantic ルールを無効化 ── */
    "unicorn/no-useless-undefined": "off",
    "unicorn/no-null": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-process-exit": "off",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/no-typeof-undefined": "off",

    /** ── Perf: CLI のファイル I/O は意図的に逐次処理のため無効化 ── */
    "no-await-in-loop": "off",

    /** ── Pedantic: コードベースに合わない制約ルールを無効化 ── */
    "no-inline-comments": "off",
    "no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "max-classes-per-file": "off",
    // `_` prefix は「通常の参照経路の外にある」ことを示すマーカーとして使う。
    // Effect TaggedError の `_tag`、ビルド時に置換される `__VERSION__`、
    // テスト専用 export の `_*ForTest`、網羅性チェックの `_exhaustive`、
    // テストで宣言だけ残しているモックとヘルパー。
    "no-underscore-dangle": "off",
    // 正規表現の対象は ASCII のパスと BMP 内の文字クラスに収まり、`u` フラグが
    // 防ぐサロゲートペアの分割が起こらない。
    "require-unicode-regexp": "off",

    /** ── Import ── */
    "import/max-dependencies": "off",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error"
  },
  "overrides": [
    {
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/consistent-type-imports": "off",
        "no-unused-vars": "warn",
        "max-lines-per-function": "off",
        "max-lines": "off",
        "require-await": "off",
        "unicorn/no-array-callback-reference": "off",
        "unicorn/no-useless-undefined": "off",
        // テストの局所ヘルパーは、対象の describe 内に置く方が対応関係を追いやすい。
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["src/utils/merge/types.ts"],
      "rules": {
        // Zod brand は同じ名前を値と型の両方に宣言する。これを再宣言と誤検知する。
        // 他のファイルでは本物の再宣言を検出したいので、対象をここへ限定する。
        "no-redeclare": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules", "dist", "/docs"]
}
